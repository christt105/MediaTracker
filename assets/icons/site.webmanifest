{
  "name": {{ .name | jsonify }},
  "short_name": {{ .short_name | jsonify }},
  "description": {{ .description | jsonify }},
  "lang": {{ .lang | jsonify }},
  "start_url": {{ .start_url | jsonify }},
  "scope": {{ .scope | jsonify }},
  "id": {{ .start_url | jsonify }},
  "icons": [
    {
      "src": {{ (resources.Get "icons/web-app-manifest-192x192.png").RelPermalink | jsonify }},
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": {{ (resources.Get "icons/web-app-manifest-512x512.png").RelPermalink | jsonify }},
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": {{ (resources.Get "icons/web-app-manifest-512x512.png").RelPermalink | jsonify }},
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "theme_color": {{ .theme_color | jsonify }},
  "background_color": {{ .background_color | jsonify }},
  "display": {{ .display | jsonify }}
}
